{
  "name": "smart-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "typecheck": "tsc -p .",
    "export-abis": "node scripts/export-abis.ts",
    "deploy:monad": "hardhat ignition deploy ignition/modules/Fanout.ts --network monadTestnet",
    "deploy:monad:test-ausd": "hardhat ignition deploy ignition/modules/FanoutTestAusd.ts --network monadTestnet --deployment-id monad-test-ausd",
    "deploy:monad:v2": "hardhat ignition deploy ignition/modules/Fanout.ts --network monadTestnet --parameters ignition/parameters/monad-v2.json --deployment-id monad-v2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-ignition-viem": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.1.0",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-node-test-runner": "^3.1.0",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@nomicfoundation/hardhat-verify": "^3.1.1",
    "@nomicfoundation/hardhat-viem": "^3.0.9",
    "@nomicfoundation/hardhat-viem-assertions": "^3.1.3",
    "@nomicfoundation/ignition-core": "^3.1.9",
    "@types/node": "^24.19.0",
    "dotenv": "^18.0.4",
    "hardhat": "^3.18.0",
    "typescript": "^5",
    "viem": "2.56.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
