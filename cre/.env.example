# Copy to .env and never commit it. `cre workflow simulate` reads this file.
# Raw hex private key, no 0x prefix, that signs simulated transactions. scripts/simulate.sh sets it
# to an anvil dev account for the local fork; for staging-settings with --broadcast use a funded
# Monad testnet key of your own.
CRE_ETH_PRIVATE_KEY=
# Optional bearer token for the scheduled-payouts schedule URL (see secrets.yaml).
FANOUT_SCHEDULE_TOKEN=
