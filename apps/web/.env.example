# Copy to .env.local. NEXT_PUBLIC_* values are baked in at build time; restart `pnpm dev` after changes.

# true (default) = in-memory mock client, no chain calls. false = viem against the contracts below.
NEXT_PUBLIC_USE_MOCK=true

# TODO: create an app at dashboard.privy.io. Leave empty to use the local mock sign-in.
NEXT_PUBLIC_PRIVY_APP_ID=

# Monad testnet (chain 10143). Optional override; defaults to https://testnet-rpc.monad.xyz
NEXT_PUBLIC_RPC_URL=

# Payout token. Empty = the token the deployed contracts use (lib/fanout/abis/contracts.generated.ts):
# currently our mintable tAUSD, since Agora's AUSD faucet on Monad testnet is empty.
# Real Agora AUSD is 0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC; only set it together with contracts deployed for it.
NEXT_PUBLIC_AUSD_ADDRESS=
NEXT_PUBLIC_AUSD_DECIMALS=6

# Optional overrides. Empty = the Monad testnet deployment in lib/fanout/abis/contracts.generated.ts
# (see smart-contract/README.md). Only used when NEXT_PUBLIC_USE_MOCK=false.
NEXT_PUBLIC_TREASURY_ADDRESS=
NEXT_PUBLIC_BATCH_PAYOUT_ADDRESS=
NEXT_PUBLIC_CLAIM_ESCROW_ADDRESS=

# Name payees see on the claim page.
NEXT_PUBLIC_PLATFORM_NAME=Demo Creator Platform

# Absolute origin for OG/social tags. Defaults to http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Server-only (no NEXT_PUBLIC_): private key of the wallet that submits payee claims and pays their gas
# (app/api/claim, lib/fanout/relayer.ts). Keep it funded with a little MON. Claims fail with 503 if unset.
RELAYER_PRIVATE_KEY=

# Server-only: private key of the claim verifier. It co-signs a claim only after checking the claimer's
# verified email (lib/fanout/relayer.ts). Its address must be ClaimEscrow.verifier (deploy parameter "verifier").
VERIFIER_PRIVATE_KEY=
# Server-only: Privy app secret (dashboard > Settings > API keys), used to look up the claimer's verified email.
PRIVY_APP_SECRET=
