# Copy to .env.local. NEXT_PUBLIC_* values are baked in at build time; restart `pnpm dev` after changes.

# Privy app (dashboard.privy.io). Required: sign-in and embedded accounts.
NEXT_PUBLIC_PRIVY_APP_ID=

# Monad testnet (chain 10143). Optional RPC override; defaults to https://testnet-rpc.monad.xyz
NEXT_PUBLIC_RPC_URL=

# Contracts default to the Monad testnet deployment in lib/fanout/abis/deployed.ts
# (regenerate with `node scripts/sync-abis.mjs`). Override only for another deployment or a local chain.
NEXT_PUBLIC_AUSD_ADDRESS=
NEXT_PUBLIC_TREASURY_ADDRESS=
NEXT_PUBLIC_BATCH_PAYOUT_ADDRESS=
NEXT_PUBLIC_CLAIM_ESCROW_ADDRESS=

# Name payees see on the claim page.
NEXT_PUBLIC_PLATFORM_NAME=Demo Creator Platform

# Absolute origin for OG/social tags. Defaults to http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# --- Server only (never NEXT_PUBLIC) ---------------------------------------------
# Relayer: submits payee claims and pays their gas. Use a testnet-only key and fund it with MON
# (https://faucet.monad.xyz). Generate one with: cast wallet new
RELAYER_PRIVATE_KEY=
# MON sent to a payee's new account after their claim, if it holds less than the threshold.
RELAYER_TOPUP_MON=0.02
RELAYER_TOPUP_BELOW_MON=0.005
