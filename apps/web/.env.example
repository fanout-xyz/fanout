# Copy to .env.local. NEXT_PUBLIC_* values are baked in at build time; restart `pnpm dev` after changes.

# true (default) = in-memory mock client, no chain calls. false = viem against the contracts below.
NEXT_PUBLIC_USE_MOCK=true

# TODO: create an app at dashboard.privy.io. Leave empty to use the local mock sign-in.
NEXT_PUBLIC_PRIVY_APP_ID=

# Monad testnet (chain 10143). Optional override; defaults to https://testnet-rpc.monad.xyz
NEXT_PUBLIC_RPC_URL=

# Payout token. Empty = the token the deployed contracts use (lib/fanout/abis/contracts.generated.ts):
# currently Agora AUSD, 0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC. Only set it together with contracts deployed for it.
NEXT_PUBLIC_AUSD_ADDRESS=
NEXT_PUBLIC_AUSD_DECIMALS=6

# Optional overrides. Empty = the Monad testnet deployment in lib/fanout/abis/contracts.generated.ts
# (see smart-contract/README.md). Only used when NEXT_PUBLIC_USE_MOCK=false.
NEXT_PUBLIC_TREASURY_ADDRESS=
NEXT_PUBLIC_BATCH_PAYOUT_ADDRESS=
NEXT_PUBLIC_CLAIM_ESCROW_ADDRESS=

# Payees can take their payout as USDC, changed through Agora's AUSD/USDC stable-swap pair by SettleToUsdc
# (smart-contract/contracts/SettleToUsdc.sol); the relayer below submits it. The settle address defaults to the
# monad-settle-usdc deployment; "off" hides the option. Other values default to Monad testnet, where the pair's USDC side is CTK (18 decimals).
NEXT_PUBLIC_SETTLE_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_USDC_DECIMALS=18
NEXT_PUBLIC_AGORA_PAIR_ADDRESS=

# "Get test dollars" on the dashboard: $10,000 from Agora's AUSD faucet, sent to the signed-in account by the
# relayer below (once per account per day; the relayer pays the fee and tops up a little MON). Only shown on
# Monad testnet, and always in the mock. "off" hides it and turns off /api/relay/test-dollars.
NEXT_PUBLIC_TEST_DOLLARS=

# Name payees see on the claim page.
NEXT_PUBLIC_PLATFORM_NAME=Demo Creator Platform

# Absolute origin for OG/social tags. Defaults to http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# "You've been paid" notifications for payees who installed the app (lib/push/config.ts). Off unless the
# three VAPID values are set AND subscriptions have somewhere to live: Upstash Redis below (the local demo,
# NEXT_PUBLIC_USE_MOCK=true, keeps them in memory). Print a key pair with: pnpm --filter web vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Server only (never NEXT_PUBLIC) ---------------------------------------------
# Notifications (see above): the VAPID private key, and a contact push services can reach (mailto:).
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com
# Upstash Redis for notification subscriptions, keyed by a hash of the payee's email (never the email).
# Set automatically by Vercel's Redis (Upstash) integration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Relayer for onchain mode: submits payee claims, payee sends (a signed AUSD transferWithAuthorization,
# /api/relay/send) and changes to USDC, and pays their gas, so payees never need MON to send. Use a
# testnet-only key and fund its address with MON (https://faucet.monad.xyz). Generate one with: cast wallet new
# Without it (or without PRIVY_APP_SECRET), sends go from the payee's own account and need MON.
RELAYER_PRIVATE_KEY=
# MON sent to a payee's new account after their claim, if it holds less than the threshold (for anything
# they do from the account directly; sending to an address doesn't need it).
RELAYER_TOPUP_MON=0.02
RELAYER_TOPUP_BELOW_MON=0.005
# Paying someone by email takes 3 transactions from the payee's account (~0.04 MON). Before it, the relayer
# fills the account up to this much MON (signed-in user, enough AUSD, once per account per 5 minutes).
RELAYER_FEE_TOPUP_MON=0.06
# Claim verifier: co-signs a claim only after checking the claimer signed in with the email the payment
# was sent to (lib/fanout/relayer.ts). Its address must be ClaimEscrow.verifier (deploy parameter "verifier").
VERIFIER_PRIVATE_KEY=
# Privy app secret (dashboard > App settings > Basics), used to look up the claimer's verified emails.
PRIVY_APP_SECRET=
